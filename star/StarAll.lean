def NetComputes : (n m k : ℕ) → ((Fin n → ℝ) → (Fin m → ℝ)) → Prop
  | n, m, 0, f =>
      ∃ (A : Matrix (Fin m) (Fin n) ℝ) (c : Fin m → ℝ), ∀ x, f x = affineApply A c x
  | n, m, (k + 1), f =>
      ∃ (p : ℕ) (g : (Fin n → ℝ) → (Fin p → ℝ)) (A : Matrix (Fin m) (Fin p) ℝ)
