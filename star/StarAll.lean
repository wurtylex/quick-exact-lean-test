`{x | ⟨a, x⟩ ≤ b}`. -/
def IsPolyhedron (n : ℕ) (S : Set (ℝn n)) : Prop :=
  ∃ (m : ℕ) (a : Fin m → ℝn n) (b : Fin m → ℝ),
