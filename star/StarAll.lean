        (∀ i, IsAffine n (g i)) ∧
        ∀ x : Fin n → ℝ, ∃ i : Fin m, ∃ ε > 0, ∀ y, dist y x < ε → f y = g i y }

/-- The depth bound `⌈log_3(n − 1)⌉ + 1` from the theorem statement, using the
