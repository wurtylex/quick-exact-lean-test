def CPWL (n : ℕ) : Set ((Fin n → ℝ) → ℝ) :=
  {f | Continuous f ∧
       ∃ (m : ℕ) (g : Fin m → ((Fin n → ℝ) → ℝ)), (∀ i, IsAffineFun (g i)) ∧
