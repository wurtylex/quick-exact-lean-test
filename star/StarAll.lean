def IsAffineTransformation (a b : ℕ) (T : (Fin a → ℝ) → (Fin b → ℝ)) : Prop :=
  ∃ (A : Matrix (Fin b) (Fin a) ℝ) (c : Fin b → ℝ), ∀ x, T x = A.mulVec x + c

