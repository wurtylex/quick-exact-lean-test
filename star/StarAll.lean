  /-- The widths `n_0, n_1, ..., n_{k+1}` of all layers (input, hidden, output). -/
  widths : Fin (k + 2) → ℕ
  widths_zero : widths ⟨0, by omega⟩ = n
  widths_last : widths ⟨k + 1, by omega⟩ = 1
  /-- The `k + 1` affine transformations `T^(1), ..., T^(k+1)`. -/
  layers : Fin (k + 1) → Affine

