  | base {n : ℕ} (T : AffineMap n 1) :
      ComputesReLU n 0 (fun x => T.apply x 0)
  | step {n m k : ℕ} (T : AffineMap n m) {g : (Fin m → ℝ) → ℝ} (hg : ComputesReLU m k g) :
