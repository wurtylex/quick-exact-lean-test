          (∀ i, IsPolyhedron n (P i)) ∧
          (∀ i, IsAffineFn n (g i)) ∧
          (∀ x : ℝn n, ∃ i, x ∈ P i) ∧
          (∀ i, ∀ x ∈ P i, f x = g i x) }

