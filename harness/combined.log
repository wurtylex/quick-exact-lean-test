@@PPCANON Agent100 ∀ x ≥ 3, {x_2 | Continuous x_2 ∧ ∃ x_3 x_4, (∀ (x_5 : Fin x_3), ∃ x_6, ∀ (x_7 : Fin x → ℝ), x_4 x_5 x_7 = (x_6.1.mulVec x_7 + x_6.2) 0) ∧ ∀ (x_5 : Fin x → ℝ), ∃ x_6, x_2 =ᶠ[nhds x_5] x_4 x_6} = {x_2 | ∃ x_3 x_4 x_5, Agent100.IsReLURepresentable x_3 ⌈Real.logb 3 (↑x - 1)⌉₊ x_5 ∧ ∀ (x_6 : Fin x → ℝ), x_2 x_6 = x_5 fun x_7 ↦ max 0 ((x_4.1.mulVec x_6 + x_4.2) x_7)}
