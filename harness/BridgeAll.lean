theorem cpwl_ne : ∃ n, Agent080.CPWL n ≠ Agent081.CPWL n := by
  refine ⟨1, fun heq => ?_⟩
  have h81 : (fun x : Fin 1 → ℝ => max 0 (x 0)) ∈ Agent081.CPWL 1 := by
    refine ⟨continuous_const.max (continuous_apply 0), 2,
