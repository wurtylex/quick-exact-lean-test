      simp only [kink, Matrix.cons_val_zero, Set.mem_setOf_eq] at hx ⊢
      exact max_eq_left hx
    · intro x hx
      simp only [kink, Matrix.cons_val_one, Matrix.head_cons, Set.mem_setOf_eq] at hx ⊢
