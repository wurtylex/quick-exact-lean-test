left as `sorry`.
-/
theorem statement :
    (∀ n, 3 ≤ n → Agent031.CPWL n = Agent031.ReLUn n (Agent031.depthBound n)) ↔
    (∀ n, 3 ≤ n → Agent032.CPWL n = Agent032.ReLUn n (Agent032.depthBound n)) := by
