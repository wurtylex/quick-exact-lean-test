/-- An affine function `ℝ^n → ℝ` (a single linear functional plus a constant). -/
def IsAffine {n : ℕ} (f : (Fin n → ℝ) → ℝ) : Prop :=
  ∃ a : Fin n → ℝ, ∃ b : ℝ, ∀ x : Fin n → ℝ, f x = (∑ i, a i * x i) + b

