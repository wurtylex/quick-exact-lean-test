functions computed by some `Agent077.Affine n m`. -/
theorem affineMap_iff (n m : ℕ) (T : (Fin n → ℝ) → (Fin m → ℝ)) :
    Agent076.IsAffineMap T ↔ ∃ S : Agent077.Affine n m, ∀ x, T x = S.eval x := by
  constructor
  · rintro ⟨A, c, hA⟩
    exact ⟨⟨A, c⟩, hA⟩
  · rintro ⟨S, hS⟩
    exact ⟨S.A, S.c, hS⟩

