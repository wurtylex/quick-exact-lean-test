      fun i => ?_, ?_, fun i => ?_⟩
    · cases i with
      | true =>
          exact ⟨Unit, inferInstance, fun _ _ => (-1 : ℝ), fun _ => 0, by
            ext x; constructor
            · exact fun hx _ => by simpa [Fin.sum_univ_one, neg_one_mul] using hx
            · exact fun hx => by simpa [Fin.sum_univ_one, neg_one_mul] using hx ()⟩
