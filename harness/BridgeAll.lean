def reluVec {m : ℕ} (x : Fin m → ℝ) : Fin m → ℝ := fun i => relu (x i)

/-- An affine transformation `ℝ^a → ℝ^b` given by a matrix `A` and bias vector `c`,
applied concretely as `x ↦ A * x + c`. -/
def affineMap {a b : ℕ} (A : Matrix (Fin b) (Fin a) ℝ) (c : Fin b → ℝ) :
    (Fin a → ℝ) → (Fin b → ℝ) :=
  fun x => A.mulVec x + c

