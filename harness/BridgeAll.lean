  {f | Continuous f ∧
        ∃ (m : ℕ) (g : Fin m → ((Fin n → ℝ) → ℝ)),
          (∀ i, IsAffineMap (g i)) ∧
          ∀ x : Fin n → ℝ, ∃ i, ∃ ε > 0, ∀ y, dist y x < ε → f y = g i y}

