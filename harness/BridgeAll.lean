/-- A function `ℝ^n → ℝ` is affine (scalar-valued affine transformation). -/
def IsAffineFun {n : ℕ} (g : (Fin n → ℝ) → ℝ) : Prop :=
  ∃ (a : Fin n → ℝ) (b : ℝ), g = fun x => (∑ i, a i * x i) + b

