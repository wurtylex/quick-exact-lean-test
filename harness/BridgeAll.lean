noncomputable def hinge : (Fin 1 → ℝ) → ℝ := fun x => max 0 (x 0)

def hPos1 : Agent091.Halfspace 1 := ⟨fun _ => -1, 0⟩
def hNeg1 : Agent091.Halfspace 1 := ⟨fun _ => 1, 0⟩
def aId1 : Agent091.AffineFun 1 1 := (fun _ _ => 1, fun _ => 0)
def aZ1 : Agent091.AffineFun 1 1 := (fun _ _ => 0, fun _ => 0)

theorem hinge_mem091 : hinge ∈ Agent091.CPWL 1 := by
  refine ⟨continuous_const.max (continuous_apply 0), 2, fun _ => 1,
    ![fun _ => hPos1, fun _ => hNeg1], ![aId1, aZ1], ?_, ?_⟩
  · apply Set.eq_univ_of_forall
    intro x
    rcases le_total 0 (x 0) with hx | hx
    · refine Set.mem_iUnion.mpr ⟨0, Set.mem_iInter.mpr fun _ => ?_⟩
      simp only [Matrix.cons_val_zero]
      simp only [hPos1, Agent091.Halfspace.set, Set.mem_setOf_eq, Fin.sum_univ_one]
      linarith
    · refine Set.mem_iUnion.mpr ⟨1, Set.mem_iInter.mpr fun _ => ?_⟩
      simp only [Matrix.cons_val_one, Matrix.head_cons]
      simp only [hNeg1, Agent091.Halfspace.set, Set.mem_setOf_eq, Fin.sum_univ_one]
      linarith
  · intro i x hx
    have h0 := hx 0
    fin_cases i
    · simp only [Matrix.cons_val_zero] at h0 ⊢
      simp only [hPos1, Agent091.Halfspace.set, Set.mem_setOf_eq, Fin.sum_univ_one] at h0
      simp only [hinge, aId1, Agent091.AffineFun.eval, Fin.sum_univ_one]
      rw [max_eq_right (by linarith : (0:ℝ) ≤ x 0)]; ring
    · simp only [Matrix.cons_val_one, Matrix.head_cons] at h0 ⊢
      simp only [hNeg1, Agent091.Halfspace.set, Set.mem_setOf_eq, Fin.sum_univ_one] at h0
      simp only [hinge, aZ1, Agent091.AffineFun.eval, Fin.sum_univ_one]
      rw [max_eq_left (by linarith : x 0 ≤ (0:ℝ))]; ring

theorem hinge_not_mem092 : hinge ∉ Agent092.CPWL 1 := by
  rintro ⟨-, m, g, hg⟩
  obtain ⟨i, hi⟩ := hg (0 : Fin 1 → ℝ)
  set φ : ℝ → (Fin 1 → ℝ) := fun t _ => t with hφ
  have hcont : Continuous φ := continuous_pi fun _ => continuous_id
  have hφ0 : φ 0 = (0 : Fin 1 → ℝ) := by ext j; simp [hφ]
  have htend : Filter.Tendsto φ (nhds (0:ℝ)) (nhds (0 : Fin 1 → ℝ)) := by
    rw [← hφ0]; exact hcont.tendsto 0
  have hi2 : ∀ᶠ t : ℝ in nhds (0:ℝ), hinge (φ t) = (g i).eval (φ t) := htend.eventually hi
  set a := (g i).1 0 0
  set b := (g i).2 0
  have key : ∀ᶠ t : ℝ in nhds (0:ℝ), max 0 t = a * t + b := by
    refine hi2.mono fun t ht => ?_
    simpa [hinge, hφ, Agent092.AffineFunc.eval, Agent092.affineEval, Matrix.mulVec,
      Matrix.dotProduct, Pi.add_apply, Fin.sum_univ_one] using ht
  rw [Metric.eventually_nhds_iff] at key
  obtain ⟨ε, hε, hball⟩ := key
  have e0 := hball (show dist (0:ℝ) 0 < ε by rw [dist_self]; exact hε)
  rw [max_self, mul_zero, zero_add] at e0
  have eb : b = 0 := e0.symm
  have e1 := hball (show dist (ε/2) (0:ℝ) < ε by
    rw [Real.dist_eq, sub_zero, abs_of_nonneg (by linarith : (0:ℝ) ≤ ε/2)]; linarith)
  have e2 := hball (show dist (-(ε/2)) (0:ℝ) < ε by
    rw [Real.dist_eq, sub_zero, abs_of_nonpos (by linarith : -(ε/2) ≤ (0:ℝ))]; linarith)
  rw [max_eq_right (by linarith : (0:ℝ) ≤ ε/2), eb, add_zero] at e1
  rw [max_eq_left (by linarith : -(ε/2) ≤ (0:ℝ)), eb, add_zero, mul_neg] at e2
  have hc : (ε/2 : ℝ) ≠ 0 := ne_of_gt (by linarith)
  have ha1 : a = 1 :=
    (mul_right_cancel₀ hc (by rw [one_mul]; exact e1)).symm
  have ha0 : a = 0 :=
    mul_right_cancel₀ hc (by rw [zero_mul]; linarith [e2])
  rw [ha1] at ha0
  norm_num at ha0

theorem cpwl_ne : ∃ n, Agent091.CPWL n ≠ Agent092.CPWL n := by
  refine ⟨1, fun hEq => ?_⟩
  exact hinge_not_mem092 (hEq ▸ hinge_mem091)

