  ⌈Real.logb 3 ((n : ℝ) - 1)⌉₊ + 1

/-! ## Theorem 2 -/

/-- **Theorem 2.** For `n ≥ 3`, `CPWL_n = ReLU_{n, ⌈log_3(n-1)⌉+1}`. -/
theorem theorem2 (n : ℕ) (hn : 3 ≤ n) :
    CPWL n = ReLUn n (depthBound n) := sorry

