         (∀ i, ∀ x ∈ P i, f x = (∑ k, A i k * x k) + c i)}

noncomputable section

/-- The depth bound `⌈log_3(n - 1)⌉ + 1` from Theorem 2, as the number of hidden layers. -/
def depthBound (n : ℕ) : ℕ := ⌈Real.logb 3 ((n : ℝ) - 1)⌉₊ + 1

end

