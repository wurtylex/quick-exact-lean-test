  have e1 := hsub hd1
  have e2 := hsub hd2
  simp only [kink, hgi, Fin.sum_univ_one] at e0 e1 e2
  rw [max_self] at e0
  simp only [mul_zero, zero_add] at e0
  rw [max_eq_right (by linarith : (0:ℝ) ≤ ε / 2)] at e1
  rw [max_eq_left (by linarith : -(ε / 2) ≤ (0:ℝ))] at e2
