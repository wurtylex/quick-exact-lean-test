    have m0 : max (0:ℝ) 0 = 0 := max_self 0
    have m1 : max (0:ℝ) (ε/2) = ε/2 := max_eq_right hδ.le
    have m2 : max (0:ℝ) (-(ε/2)) = 0 := max_eq_left (by linarith)
