out of reach here. -/
theorem statement :
    (∀ n, 3 ≤ n → Agent051.CPWL n = Agent051.ReLUn n (Agent051.depthBound n)) ↔
    (∀ n, 3 ≤ n → Agent052.CPWL n = Agent052.ReLUn n (Agent052.depthBound n)) := by
  sorry

end Bridge_051_052
