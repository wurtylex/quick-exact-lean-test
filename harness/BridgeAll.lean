`Filter.eventually_iff_exists_mem`. -/
theorem cpwl (n : ℕ) : Agent018.CPWL n = Agent019.CPWL n := by
  ext f
  constructor
  · rintro ⟨hf, m, g, hg⟩
    refine ⟨hf, m, fun j => (g j).eval, fun j => ⟨(g j).a, (g j).b, fun x => rfl⟩, ?_⟩
    intro x
    obtain ⟨i, hi⟩ := hg x
    obtain ⟨U, hU, hUf⟩ := Filter.eventually_iff_exists_mem.mp hi
    exact ⟨i, U, hU, hUf⟩
