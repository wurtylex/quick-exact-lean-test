          have hx' : x 0 ≤ 0 := hx
          simp [kink, max_eq_left hx']
  have hnot73 : kink ∉ Agent073.CPWL 1 := by
    rintro ⟨-, S, hS⟩
    obtain ⟨T, -, U, hU, hT⟩ := hS (fun _ => (0 : ℝ))
    have hcm : Continuous (fun t : ℝ => (fun _ : Fin 1 => t)) :=
