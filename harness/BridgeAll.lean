  constructor
  · rintro ⟨a, c, ha⟩
    exact ⟨a, c, fun x => by rw [ha x]; ring⟩
  · rintro ⟨w, b, hw⟩
    exact ⟨w, b, fun x => by rw [hw x]; ring⟩

