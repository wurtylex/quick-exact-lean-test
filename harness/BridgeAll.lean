def ReLUNetwork.Computes {n k : ℕ} (net : ReLUNetwork n k) (f : (Fin n → ℝ) → ℝ) : Prop :=
  ∀ x : Fin n → ℝ, f x = net.netForward (k + 1) (toSeq x) 0

