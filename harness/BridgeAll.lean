def toB {a b : ℕ} (T : Agent081.Affine a b) : Agent082.AffineMap' a b := ⟨T.A, T.c⟩

def toA {a b : ℕ} (T : Agent082.AffineMap' a b) : Agent081.Affine a b := ⟨T.A, T.c⟩

