      ![(⟨fun _ _ => (0:ℝ), fun _ => (0:ℝ)⟩ : Agent081.Affine 1 1),
        (⟨fun _ _ => (1:ℝ), fun _ => (0:ℝ)⟩ : Agent081.Affine 1 1)],
