def IsReLUNetworkFunc : (k n : ℕ) → ((Fin n → ℝ) → ℝ) → Prop
  | 0, _n, f => IsAffineFun f
  | (k + 1), n, f =>
      ∃ (m : ℕ) (T : AffineMap n m) (g : (Fin m → ℝ) → ℝ),
