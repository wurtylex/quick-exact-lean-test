    ext x
    simp only [Set.mem_setOf_eq, Fin.forall_fin_one, heval]
    constructor <;> intro h <;> linarith
  have hpoly1 : Agent093.IsPolyhedron 1 {x : Fin 1 → ℝ | x 0 ≤ 0} := by
    refine ⟨1, fun _ => (((fun _ _ => (1 : ℝ)), (fun _ => (0 : ℝ))) : Agent093.AffFun 1), ?_⟩
    ext x
    simp only [Set.mem_setOf_eq, Fin.forall_fin_one, heval]
    constructor <;> intro h <;> linarith
